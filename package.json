{
  "name": "cosmofi-workspace",
  "private": true,
  "workspaces": [
    "site",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run -F site dev",
    "build": "bun run -F site build",
    "preview": "bun run -F site preview",
    "check": "bun run -F site check",
    "check:watch": "bun run -F site check:watch",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
